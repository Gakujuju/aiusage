{
  "name": "@juliantanx/aiusage-widget",
  "version": "1.5.12",
  "private": false,
  "description": "System tray widget for AIUsage — view AI token usage from your system tray",
  "keywords": [
    "ai",
    "aiusage",
    "widget",
    "system-tray",
    "electron",
    "token-usage"
  ],
  "homepage": "https://aiusage.jtanx.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliantanx/aiusage.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/juliantanx/aiusage/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "README_zh.md"
  ],
  "bin": {
    "aiusage-widget": "bin/launcher.js"
  },
  "scripts": {
    "dev": "concurrently --names \"vite,tsc,electron\" --kill-others --success command-electron \"vite build --watch\" \"tsc -p tsconfig.json --watch\" \"node -e \\\"require('wait-on')({resources:['dist/main.js']},()=>{const c=require('child_process').spawn(require('electron'),['.'],{stdio:'inherit'});c.on('exit',(code,signal)=>process.exit(code ?? (signal ? 1 : 0)))})\\\"\"",
    "build": "node -e \"require('fs').rmSync('dist/renderer',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.json",
    "pack": "pnpm build && electron-builder",
    "test": "vitest run",
    "check:css-vars": "node ../../scripts/check-css-vars.cjs .",
    "pretest": "node ../../scripts/check-css-vars.cjs . && pnpm check:types",
    "check:types": "svelte-check --tsconfig ./tsconfig.renderer.json --threshold error"
  },
  "dependencies": {
    "electron": "^33.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/node": "*",
    "concurrently": "^8.0.0",
    "electron-builder": "^25.0.0",
    "svelte": "^4.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "wait-on": "^7.0.0"
  }
}
